---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary';
}

const { variant = 'secondary', class: className, ...rest } = Astro.props;

const variants = {
  primary:
    'btn-primary bg-accent text-accent-ink [--rule-c:var(--color-accent)] hover:bg-ink hover:[--rule-c:var(--color-ink)]',
  secondary:
    'btn-secondary bg-transparent text-ink [--rule-c:var(--color-ink)] hover:bg-ink hover:text-paper',
};
---

<a
  class:list={[
    'inline-flex min-h-12 items-center justify-center gap-2 rule-box rounded-full px-5 [--rule-w:2px] font-medium transition-colors duration-200',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
