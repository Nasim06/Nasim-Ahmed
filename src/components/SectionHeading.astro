---
interface Props {
  id: string;
  index: string;
  title: string;
}
const { id, index, title } = Astro.props;
---

<div class="rule-t rule-strong flex items-baseline justify-between gap-4 pt-4">
  <h2 id={id} class="text-3xl font-bold tracking-tight sm:text-4xl">
    {title}
  </h2>
  <span class="label circled text-ink-muted" aria-hidden="true">
    {index}
  </span>
</div>
