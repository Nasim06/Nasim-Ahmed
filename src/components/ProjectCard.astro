---
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, context, year, stack, outcomes } = project.data;
const number = String(index + 1).padStart(2, '0');
const headline = outcomes[0];
---

<!--
  The whole card is clickable via the stretched ::after on the title link,
  but there's only one link (and one tab stop) per card.
-->
<article class="group relative grid gap-6 border-b border-rule py-8 transition-colors hover:border-ink md:grid-cols-12 md:gap-8 md:py-10">
  <p class="label hidden text-ink-muted md:col-span-1 md:block" aria-hidden="true">
    {number}
  </p>

  <div class="md:col-span-7">
    <p class="label text-ink-muted">
      {context} · {year}
    </p>
    <h3 class="mt-3 text-2xl leading-tight font-bold tracking-tight sm:text-3xl">
      <a
        href={`/work/${project.id}`}
        class="group-hover:text-accent after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
      >
        {title}
      </a>
    </h3>
    <p class="mt-3 max-w-prose text-ink-muted">{summary}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tech stack">
      {stack.map((tech) => (
        <li class="label rounded-full border border-rule px-2.5 py-1">{tech}</li>
      ))}
    </ul>
  </div>

  <div class="flex items-end justify-between gap-4 md:col-span-4 md:flex-col md:items-end">
    {headline && (
      <p class="md:text-right">
        <span class="block font-display text-4xl font-bold text-accent">{headline.value}</span>
        <span class="label text-ink-muted">{headline.label}</span>
      </p>
    )}
    <span
      class="label inline-flex items-center gap-2 text-ink transition-transform duration-300 group-hover:translate-x-1 md:mt-auto"
      aria-hidden="true"
    >
      Read case study →
    </span>
  </div>
</article>

<style>
  /* Draw the focus ring around the whole card, not just the title text. */
  article:has(a:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
