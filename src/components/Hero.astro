---
import { site } from '@/data/site';
import AvailabilityBadge from './AvailabilityBadge.astro';
import ButtonLink from './ButtonLink.astro';
---

<section aria-labelledby="hero-title" class="container-page pt-10 pb-20 sm:pt-16 sm:pb-28">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
    {site.openToWork && <AvailabilityBadge label={site.availability} />}
    <p class="label text-ink-muted">
      {site.role} · {site.location}
    </p>
  </div>

  <!-- w-fit so the paper-theme scribble matches the name, whatever the font. -->
  <div class="mt-8 w-fit sm:mt-10">
    <h1 id="hero-title" class="accent-dot text-display font-extrabold">
      {site.name}
    </h1>
    <svg
      class="scribble paper-only mt-1 h-5 w-[92%] text-accent sm:h-6"
      viewBox="0 0 480 24"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4 15 C 70 7, 130 20, 200 12 S 330 6, 400 13 S 460 17, 476 9"
        pathLength="1"
        fill="none"
        stroke="currentColor"
        stroke-width="3.5"
        stroke-linecap="round"
        filter="url(#sketch)"
      ></path>
    </svg>
  </div>

  <p class="mt-6 max-w-[34ch] text-xl leading-snug sm:mt-8 sm:text-2xl md:text-3xl">{site.pitch}</p>

  <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <span class="label text-accent">Now</span>
    <span class="text-ink-muted">{site.now}</span>
  </p>

  <ul class="mt-10 flex flex-wrap gap-3" aria-label="Quick links">
    <li>
      <ButtonLink href="#work" variant="primary">
        See selected work <span aria-hidden="true">↓</span>
      </ButtonLink>
    </li>
    <li>
      <ButtonLink href={site.links.cv} data-astro-prefetch="false">
        Download CV <span class="sr-only">(PDF)</span>
      </ButtonLink>
    </li>
    <li>
      <ButtonLink href={site.links.github} rel="me">
        GitHub
      </ButtonLink>
    </li>
    <li>
      <ButtonLink href={site.links.linkedin} rel="me">
        LinkedIn
      </ButtonLink>
    </li>
  </ul>
</section>
