---
import ButtonLink from '@/components/ButtonLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="container-page py-20 sm:py-32">
    <p class="label text-ink-muted">Error 404</p>
    <h1 class="accent-dot mt-4 text-6xl font-extrabold tracking-tight sm:text-8xl">Nothing here</h1>
    <p class="mt-6 max-w-prose text-xl">
      That page doesn't exist, or it moved. The work is still where you left it.
    </p>
    <div class="mt-10">
      <ButtonLink href="/" variant="primary">
        Back to the homepage
      </ButtonLink>
    </div>
  </section>
</BaseLayout>
